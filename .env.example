# Documentation only. Folio does not automatically load this file.
# No API key is required to run Folio.
# Set these in the build process environment for custom Android signing.
# FOLIO_ANDROID_KEYSTORE=/absolute/path/outside/repository/folio-release.p12
# FOLIO_ANDROID_STORE_PASSWORD=<from-your-secret-manager>
# FOLIO_ANDROID_KEY_ALIAS=folio-release
# FOLIO_ANDROID_KEY_PASSWORD=<from-your-secret-manager>
